#!/bin/bash
#
# Installs Claude Code and symlinks the config in this repo into ~/.claude.
# Safe to run repeatedly. Can be run standalone or from bin/install.

set -e

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DOTFILES
source "$DOTFILES/bin/lib.sh"

CLAUDE_SRC="$DOTFILES/config/claude"
CLAUDE_DIR="$HOME/.claude"

echo "Setting up Claude Code..."

[ -d "$CLAUDE_SRC" ] || abort "$CLAUDE_SRC not found, aborting"

# Install the CLI if it isn't there yet
if command -v claude >/dev/null 2>&1; then
  ok "Claude Code already installed"
elif command -v brew >/dev/null 2>&1; then
  brew install --cask claude-code
else
  curl -fsSL https://claude.ai/install.sh | bash
fi

mkdir -p "$CLAUDE_DIR"

link "$CLAUDE_SRC/CLAUDE.md" "$CLAUDE_DIR/CLAUDE.md"
link "$CLAUDE_SRC/laravel-php-guidelines.md" "$CLAUDE_DIR/laravel-php-guidelines.md"
link "$CLAUDE_SRC/settings.json" "$CLAUDE_DIR/settings.json"
link "$CLAUDE_SRC/statusline.sh" "$CLAUDE_DIR/statusline.sh"
link "$CLAUDE_SRC/skills" "$CLAUDE_DIR/skills"
link "$CLAUDE_SRC/agents" "$CLAUDE_DIR/agents"

# MCP servers cannot be symlinked. Claude Code keeps them in ~/.claude.json,
# which also holds machine specific state like startup counts and project
# history, so registering them through the CLI is what makes them reproducible.
# OAuth is still a manual step, see the readme.
if command -v claude >/dev/null 2>&1; then
  if claude mcp get ploi >/dev/null 2>&1; then
    ok "ploi MCP server already registered"
  elif claude mcp add --scope user --transport http ploi https://ploi.io/api/mcp >/dev/null 2>&1; then
    ok "ploi MCP server registered"
  else
    warn "could not register the ploi MCP server"
  fi

  # The token is kept as a ${INTILLI_MCP_TOKEN} reference (single quotes), so it
  # is not written to ~/.claude.json. Claude Code expands it at runtime from the
  # shell env, which env.zsh populates from the op-injected .env.
  if claude mcp get nodux >/dev/null 2>&1; then
    ok "nodux MCP server already registered"
  elif claude mcp add --scope user --transport http nodux https://intilli.be/backend/mcp \
      --header 'Authorization: Bearer ${INTILLI_MCP_TOKEN}' >/dev/null 2>&1; then
    ok "nodux MCP server registered"
  else
    warn "could not register the nodux MCP server"
  fi

  if claude mcp get larabug >/dev/null 2>&1; then
    ok "larabug MCP server already registered"
  elif claude mcp add --scope user --transport http larabug https://www.larabug.com/mcp >/dev/null 2>&1; then
    ok "larabug MCP server registered"
  else
    warn "could not register the larabug MCP server"
  fi

  # Ray serves this from the desktop app itself, on a port it opens at launch,
  # so there is nothing to install and no token to keep out of the way. It only
  # answers while Ray is running; Claude Code reports it as failed otherwise,
  # which is the honest answer.
  if claude mcp get ray >/dev/null 2>&1; then
    ok "ray MCP server already registered"
  elif claude mcp add --scope user --transport http ray http://localhost:2411/mcp >/dev/null 2>&1; then
    ok "ray MCP server registered"
  else
    warn "could not register the ray MCP server"
  fi

  # Same ${VAR} trick as nodux: the API token stays out of ~/.claude.json and is
  # expanded at runtime from the shell env.
  # Note: @shortcut/mcp is deprecated in favour of the hosted server at
  # https://mcp.shortcut.com/mcp, which authenticates over OAuth instead of an
  # API token. Swap this block once that migration is made.
  if claude mcp get shortcut >/dev/null 2>&1; then
    ok "shortcut MCP server already registered"
  elif claude mcp add --scope user shortcut \
      -e 'SHORTCUT_API_TOKEN=${SHORTCUT_KEY_TNT}' \
      -- npx -y @shortcut/mcp@latest >/dev/null 2>&1; then
    ok "shortcut MCP server registered"
  else
    warn "could not register the shortcut MCP server"
  fi
else
  warn "claude not on PATH, skipping MCP servers"
fi

# Claude Code expands the ${VAR} references above from its own process
# environment. That works under iTerm, where ~/.zshrc has already run, but not
# when Claude Code is started by a GUI app: launchd gives those no interactive
# shell, so the Authorization header goes out as the literal string and the
# server answers 401. This agent publishes the same variables into the launchd
# session at login. See the MCP servers section of the readme for the tradeoff.
AGENT_LABEL="be.intilli.mcp-env"
AGENT_PLIST="$HOME/Library/LaunchAgents/$AGENT_LABEL.plist"

mkdir -p "$HOME/Library/LaunchAgents"
link "$DOTFILES/macos/$AGENT_LABEL.plist" "$AGENT_PLIST"

# Reload rather than load, so rerunning this picks up an edited plist.
launchctl bootout "gui/$(id -u)/$AGENT_LABEL" >/dev/null 2>&1 || true
if launchctl bootstrap "gui/$(id -u)" "$AGENT_PLIST" >/dev/null 2>&1; then
  ok "$AGENT_LABEL loaded, MCP credentials published to the launchd session"
else
  warn "could not load $AGENT_LABEL, it will start at the next login"
fi

echo "Claude Code setup complete. Restart Claude Code to pick up the changes."
